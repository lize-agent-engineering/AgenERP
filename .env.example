# mission-driver engine location.
# The engine is NOT copied into this repo — it lives in the shared
# attractor-guided-engineering-template. Set this to the path of the template's
# tools/mission-driver/ directory. Relative paths are resolved from repo root.
MISSION_DRIVER_HOME=tools/mission-driver

# ---------------------------------------------------------------------------
# docker-compose.yml 用到的变量（roadmap 工作项 3「零依赖启动」）
#
# 全部可以不填：compose 里每个变量都写成 ${VAR:-默认值}，一个都不配也能
# `docker compose config -q` 与 `docker compose up -d`。这里列出来只是为了让
# 「能改什么」是明写的，不是让你必须填。
#
# ⚠️ 默认口令只供本地零依赖启动。对外暴露前必须改。
#
# ⚠️⚠️ **凭据不放这里，也不放 `.env`。**（用户 2026-08-24 明示）
# 真凭据一律放**仓库目录之外**：`~/.config/agenerp/secrets.env`（0600）。
# 下面几行留着只是为了让「能配什么」是明写的 —— **值一律留空**。
# 加载方式：set -a; . ~/.config/agenerp/secrets.env; set +a
# 理由：`.env` 就在仓库目录里，一次 `git add -A`、一次 gitignore 失误、
# 一次误把目录整个打包，凭据就出去了。放在目录外，这些路径全部不存在。
# ⚠️ 绑定地址不在这里 —— 端口一律硬编码只绑 127.0.0.1，不接受变量覆盖。
# ---------------------------------------------------------------------------
# MariaDB root 口令，同时用作建站时的 --db-root-password。默认 changeit
# ⚠️ 非默认值放 ~/.config/agenerp/secrets.env，不放这里
AGENERP_DB_PASSWORD=
# 站点 Administrator 口令。默认 admin
AGENERP_ADMIN_PASSWORD=
# 前端在宿主上的端口（仍只绑 127.0.0.1）。默认 8080
AGENERP_HTTP_PORT=
# AI 能力：不配即「未配置」状态，不是错误状态（system-baseline.md §14 规则 2）
AGENERP_LLM_ENDPOINT=
# ⚠️ **永远留空。** 真 key 放 ~/.config/agenerp/secrets.env
AGENERP_LLM_API_KEY=
AGENERP_LLM_MODEL=
