# ┌──────────────────────────────────────────────────────────────────────────┐
# │ AgenERP · 这是上游 frappe/erpnext:v15.119.3 里                            │
# │ /templates/nginx/frappe.conf.template 的**副本**，加了两段本仓自己的东西。│
# │ 落点节：docs/architecture/module-boundaries.md §7.21 `D-b-1`（候选 A）。 │
# │                                                                          │
# │ 本仓加的两段一律用成对哨兵注释围起来（见下文那两对 AgenERP 哨兵行）。    │
# │ 升级镜像 tag 时**必须**跑这条，期望差集只有那两段：                      │
# │   docker run --rm --entrypoint cat frappe/erpnext:<新 tag> \             │
# │     /templates/nginx/frappe.conf.template | diff - tools/nginx/frappe.conf.template
# │ 多出任何一行都要人判断要不要跟进 —— 副本与上游的分叉是**静默的**，       │
# │ nginx -t 不会报，栈照样起。K3 的全部对冲就是 tag 钉死 + 这条 diff。       │
# │                                                                          │
# │ ⚠️ 上游 entrypoint 的 envsubst 只替换八个名字（BACKEND / SOCKETIO /      │
# │    UPSTREAM_REAL_IP_ADDRESS / UPSTREAM_REAL_IP_HEADER /                  │
# │    UPSTREAM_REAL_IP_RECURSIVE / FRAPPE_SITE_NAME_HEADER /                │
# │    PROXY_READ_TIMEOUT / CLIENT_MAX_BODY_SIZE）。                          │
# │    本仓加的两段里不许出现这八个之外的 compose 风格插值：写了不会被替换，  │
# │    nginx 配置。nginx 自己的 $host / $remote_addr 等不受影响，正是要的。   │
# └──────────────────────────────────────────────────────────────────────────┘

upstream backend-server {
	server ${BACKEND} fail_timeout=0;
}

upstream socketio-server {
	server ${SOCKETIO} fail_timeout=0;
}

# Parse the X-Forwarded-Proto header - if set - defaulting to $scheme.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
	default $scheme;
	https https;
}

server {
	listen 8080;
	server_name ${FRAPPE_SITE_NAME_HEADER};
  absolute_redirect off;
	root /home/frappe/frappe-bench/sites;

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	include /etc/nginx/snippets/security_headers.conf;

	set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS};
	real_ip_header ${UPSTREAM_REAL_IP_HEADER};
	real_ip_recursive ${UPSTREAM_REAL_IP_RECURSIVE};

	# >>> AgenERP —— 同源那一跳（§7.21 `D-b-1` / `D-b-8`）
	# 前缀 `/agenerp/` 必须与 agenerp/serve/app.py 的 ROUTE_PREFIX 逐字一致，
	# 判据②从两个文件各读一次再比，不在判据里写第三个字面量。
	#
	# 这段必须坐在**这个** server 块里（唯一那个 listen 8080 的）。放进 conf.d/ 下
	# 另起一个同 listen 同 server_name 的 server 块时，nginx 实测只 warn
	# （`conflicting server name ... ignored`）而 `nginx -t` 退 0 ——
	# 配置测试全绿、反代根本不存在。判据⑧ 守的就是这一格。
	#
	# ⚠️⚠️ **为什么是 resolver + 变量，而不是一个 upstream 块**（§7.21 `D-b-8`，实测出来的）：
	# nginx 在**加载配置那一刻**解析所有 `upstream` 里的主机名，解析不出来就
	# `[emerg] host not found in upstream` 并**退出**（不重试）。而 frontend 是
	# `restart: on-failure` ⇒ 一旦 agenerp-serve 那一刻不在（重启中 / 还没起 / 被停掉），
	# **整个 frontend 陷入重启循环**，连 Frappe 本身都对外不可用。
	# 实测复现：`docker compose stop agenerp-serve && docker compose up -d --force-recreate --no-deps frontend`
	# → 逐字 `[emerg] host not found in upstream "agenerp-serve:8330"`，frontend `restarting`。
	# 把名字放进**变量**并给一个 `resolver`，nginx 就改成**每次请求时**解析：
	# 启动不再依赖它在不在，它不在时这一条 location 回 502，**其余路由一律不受影响**。
	# 127.0.0.11 是 docker 的内嵌 DNS（compose 网络内固定），字面写死。
	resolver 127.0.0.11 valid=10s ipv6=off;
	set $agenerp_serve_host agenerp-serve;
	#
	# proxy_read_timeout 显式给 300：单次解释实测 9.7 万–12.8 万 token，
	# 上游模板给 @webserver 的那个读超时变量（compose 侧给 120）对它不够，
	# 而这里刻意不复用那个变量 —— 解释请求的时长与 Frappe 页面请求的时长是两件事，
	# 共用一个旋钮时调其中一个必然误伤另一个。
	# ⚠️ 这是**服务端**读超时；断言体自己的 TIMEOUT = 30 是**客户端**侧，两者别混。
	location /agenerp/ {
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_read_timeout 300;
		proxy_send_timeout 300;
		proxy_redirect off;

		proxy_pass http://$agenerp_serve_host:8330;
	}

	# ---- Desk 注入接缝（§7.22 `D-c-1` 选 (I)）------------------------------------
	# 目的：让**登录后的 Desk 页面**加载到本仓 git 里的那段 JS，且与解释服务同源。
	#
	# ⚠️⚠️ **为什么另起一个 location，而不是在 server 级开 sub_filter**（`D-c-1` 的 (H)，
	# 一次可复原的临时施加实测过，不是推断）：server 级 sub_filter 的作用面是
	# **所有 text/html 响应** —— 实测 `/login`（门户页）也被注入 1 次、
	# `/files/<不存在>.html`（走下面那条 `location ~ ^/files/.*.(htm|html|svg|xml)`，
	# 带 Content-disposition: attachment）也被注入 1 次。**那是把注入串写进用户下载的 HTML。**
	# 收窄到这一个 location，作用面就只剩 Desk 一条路由。
	#
	# ⚠️⚠️ **为什么这里要抄一份 @webserver 的头，而不是 `try_files ... @webserver`**：
	# nginx 的体过滤器与 proxy_set_header 都按**最终处理请求的那个 location** 取配置。
	# 写成 try_files 会让请求内部跳进 @webserver，**本块的 sub_filter 随之静默失效**
	# （配置全绿、注入物不见）。这是结构性原因，不是写法偏好。
	# 代价照实记：下面这一份是**上游 @webserver 的孪生**，上游随镜像 tag 改了而这里没跟，
	# Desk 会**静默走偏**（不是报错，是行为不同）。判据⑤ 比对两边的头集合守它。
	#
	# ⚠️ sub_filter 只在**上游不压缩**时有效。实测（带真 sid 打 backend:8000/app）
	# 上游**不回** Content-Encoding ⇒ 本块**不需要** `proxy_set_header Accept-Encoding "";`。
	# 上游哪天开始回 gzip，第一处置就是把那一行加**在本块内**（上游一行不动）。
	#
	# 注入的 URL 前缀必须与 agenerp/serve/app.py 的 ROUTE_PREFIX 逐字一致、
	# 文件名必须与 ASSET_FILENAME 逐字一致 —— 判据从两个文件各读一次再比，
	# 不在判据里写第三个字面量（沿用 §14.11 的口径）。
	location ^~ /app {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;

		sub_filter '</body>' '<script src="/agenerp/desk.js"></script></body>';
		sub_filter_once on;

		proxy_pass http://backend-server;
	}
	# <<< AgenERP

	location /assets {
		try_files $uri =404;
	}

	location ~ ^/protected/(.*) {
		internal;
		try_files /${FRAPPE_SITE_NAME_HEADER}/$1 =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Origin $proxy_x_forwarded_proto://${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;

		proxy_pass http://socketio-server;
	}

	location / {
		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		location ~ ^/files/.*.(htm|html|svg|xml) {
			include /etc/nginx/snippets/security_headers.conf;
			add_header Content-disposition "attachment";
			try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
		}

		try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
	}

	location @webserver {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;

		proxy_pass  http://backend-server;
	}

	# optimizations
	sendfile on;
	keepalive_timeout 15;
	client_max_body_size ${CLIENT_MAX_BODY_SIZE};
	client_body_buffer_size 16K;
	client_header_buffer_size 1k;

	# enable gzip compression
	# based on https://mattstauffer.co/blog/enabling-gzip-on-nginx-servers-including-laravel-forge
	gzip on;
	gzip_http_version 1.1;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/atom+xml
		application/javascript
		application/json
		application/rss+xml
		application/vnd.ms-fontobject
		application/x-font-ttf
		application/font-woff
		application/x-web-app-manifest+json
		application/xhtml+xml
		application/xml
		font/opentype
		image/svg+xml
		image/x-icon
		text/css
		text/plain
		text/x-component;
		# text/html is always compressed by HttpGzipModule
}
